# =============================================================================
# ReachInbox — Environment Variables Template
#
# Copy this file to backend/.env and fill in your real values.
# NEVER commit the real .env file to Git.
#
# Usage:
#   cp .env.example backend/.env
#   nano backend/.env   (then fill in your values)
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================

# "production" or "development"
NODE_ENV=production

# Port the Express API listens on (inside Docker: always 5000)
PORT=5000

# =============================================================================
# FRONTEND / BACKEND URLS
# These control CORS and OAuth redirect URLs.
# =============================================================================

# Your Vercel frontend URL (NO trailing slash)
# Example: https://reachinbox.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Your Oracle VM backend URL (NO trailing slash)
# Example: https://api.yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# =============================================================================
# DATABASE — PostgreSQL
# In production Docker: use the container name 'postgres' as the host
# =============================================================================

# Full Prisma connection string
DATABASE_URL=postgresql://reachinbox_user:CHANGE_THIS_PASSWORD@postgres:5432/reachinbox

# These are used by docker-compose.prod.yml to configure the postgres container
POSTGRES_USER=reachinbox_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=reachinbox

# =============================================================================
# REDIS — BullMQ queue + rate limiting
# In production Docker: use 'redis' as the host
# =============================================================================

REDIS_URL=redis://redis:6379

# =============================================================================
# ELASTICSEARCH — Email search index
# In production Docker: use 'elasticsearch' as the host
# =============================================================================

ELASTICSEARCH_URL=http://elasticsearch:9200

# Only needed if you enable Elasticsearch security (xpack.security.enabled=true)
# Leave blank for the default single-node setup
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# =============================================================================
# SESSIONS — Authentication cookie security
# Generate a strong random value: openssl rand -hex 32
# =============================================================================

SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-characters

# =============================================================================
# GOOGLE OAUTH
# Get these from Google Cloud Console > APIs & Services > Credentials
# See deployment guide Section 16 for exact steps
# =============================================================================

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The full URL Google will redirect to after login
# Must match EXACTLY what you entered in Google Cloud Console
# Format: https://YOUR_BACKEND_DOMAIN/auth/google/callback
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# =============================================================================
# SLACK OAUTH
# Get these from api.slack.com > Your Apps
# See deployment guide Section 17 for exact steps
# =============================================================================

SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# The full URL Slack will redirect to after authorization
# Must match EXACTLY what you entered in your Slack App settings
# Format: https://YOUR_BACKEND_DOMAIN/api/slack/callback
SLACK_REDIRECT_URI=https://api.yourdomain.com/api/slack/callback

# =============================================================================
# ETHEREAL SMTP — Test email sending
# Create a free account at https://ethereal.email (click "Create Ethereal Account")
# Then use the SMTP credentials shown on the page.
# =============================================================================

ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your.ethereal.username@ethereal.email
ETHEREAL_PASSWORD=your-ethereal-password
ETHEREAL_FROM=your.ethereal.username@ethereal.email

# =============================================================================
# DEMO ADMIN — Platform Admin account for Bull Board access
# Run `npm run seed:demo` in the backend after setting these.
# These credentials are used for the evaluator/demo login.
# =============================================================================

DEMO_ADMIN_EMAIL=admin@yourdomain.com
DEMO_ADMIN_PASSWORD=a-secure-password-at-least-8-chars

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================

# Number of emails the worker processes simultaneously
# Recommended: 3-5 for a single Oracle Always Free VM
WORKER_CONCURRENCY=5

# Minimum delay (milliseconds) between individual email sends within a campaign
# 2000 = 2 seconds between each email
MIN_EMAIL_DELAY_MS=2000

# Maximum emails per hour per sender (global ceiling, enforced via Redis Lua script)
# This is ADDITIONAL to per-campaign hourlyLimit
MAX_EMAILS_PER_HOUR=200
