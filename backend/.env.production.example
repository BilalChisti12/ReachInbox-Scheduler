# =============================================================================
# ReachInbox — Production Environment Variables (Render)
#
# Set ALL of these in the Render Dashboard → Your Service → Environment tab.
# This file is a reference template — do NOT commit real credentials.
# =============================================================================

# --- Application ---
NODE_ENV=production
PORT=5000

# --- Frontend URL (Vercel) ---
# Used for CORS, OAuth redirects, and post-login navigation.
# Must match your Vercel deployment URL exactly (NO trailing slash).
# Supports comma-separated origins for preview URLs:
#   FRONTEND_URL=https://reachinbox.vercel.app,https://reachinbox-git-main.vercel.app
FRONTEND_URL=https://YOUR_APP.vercel.app

# --- PostgreSQL (Cloud: Neon, Render Postgres, Supabase, etc.) ---
# Full connection string including SSL.
# Neon example:    postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/reachinbox?sslmode=require
# Render example:  postgresql://user:pass@dpg-xxx.oregon-postgres.render.com/reachinbox
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/reachinbox?sslmode=require

# --- Redis (Cloud: Upstash, Render Redis, Redis Cloud, etc.) ---
# Used for BullMQ queues, rate limiting, session storage, and notification dedup.
# Upstash example: rediss://default:xxx@us1-xxx.upstash.io:6379
# Render example:  redis://red-xxx.oregon-redis.render.com:6379
# NOTE: Use rediss:// (with double-s) for TLS connections.
REDIS_URL=redis://HOST:6379

# --- Elasticsearch (Cloud: Bonsai, Elastic Cloud, etc.) ---
# Used for full-text email search. If unavailable, search degrades gracefully.
# Bonsai example:  https://user:pass@xxx.us-east-1.bonsaisearch.net:443
# Elastic Cloud:   https://xxx.es.us-central1.gcp.cloud.es.io:443
# Leave empty to disable Elasticsearch entirely (search will fall back to DB).
ELASTICSEARCH_URL=https://USER:PASS@HOST:443
# ELASTICSEARCH_USERNAME=  (only if URL doesn't include credentials)
# ELASTICSEARCH_PASSWORD=

# --- Session Secret ---
# Generate with: openssl rand -hex 32
# MUST be the same across all instances and restarts.
SESSION_SECRET=GENERATE_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# --- Google OAuth ---
# Get from Google Cloud Console → APIs & Services → Credentials
# Callback URL must match EXACTLY what's in Google Console.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://YOUR_RENDER_BACKEND.onrender.com/auth/google/callback

# --- Slack OAuth ---
# Get from api.slack.com → Your Apps
# Redirect URI must match EXACTLY what's in Slack App settings.
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_REDIRECT_URI=https://YOUR_RENDER_BACKEND.onrender.com/api/slack/callback

# --- Ethereal SMTP (Test Email Sending) ---
# Create free account at https://ethereal.email
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your.user@ethereal.email
ETHEREAL_PASSWORD=your-ethereal-password

# --- Worker Configuration ---
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# --- Demo Admin ---
DEMO_ADMIN_EMAIL=admin@yourdomain.com
DEMO_ADMIN_PASSWORD=a-secure-password
