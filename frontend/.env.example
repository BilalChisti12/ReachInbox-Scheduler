# =============================================================================
# Frontend Environment Variables
#
# VITE_API_URL — The full URL of the backend API (NO trailing slash)
#
# Local development:  VITE_API_URL=http://localhost:5000
# Production (Vercel): Set this in the Vercel Dashboard → Settings → Environment Variables
#                      Example: VITE_API_URL=https://reachinbox-api.onrender.com
#
# IMPORTANT: Vite bakes environment variables at BUILD TIME.
# Changing this after build has NO effect. You must rebuild/redeploy.
# =============================================================================

VITE_API_URL=http://localhost:5000
